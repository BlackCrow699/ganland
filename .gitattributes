# Keep Unity text assets mergeable and normalize source text.
*.meta      text
*.asset     text
*.anim      text
*.controller text
*.prefab    text
*.unity     text
*.mat       text
*.shader    text
*.shadergraph text
*.json      text
*.txt       text
*.md        text
*.cs        text
# Binary source assets: do not attempt text diffs or merges.
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg       binary
*.jpeg      binary
*.tga filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.max filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.wav       binary
*.mp3       binary
*.ogg       binary
*.mp4       binary
*.mov       binary
*.PSD filter=lfs diff=lfs merge=lfs -text
*.TGA filter=lfs diff=lfs merge=lfs -text
*.PNG filter=lfs diff=lfs merge=lfs -text
*.MAX filter=lfs diff=lfs merge=lfs -text
*.FBX filter=lfs diff=lfs merge=lfs -text
